# APP_URL: The public URL of this application (e.g., https://triad-intellect.com)
APP_URL="https://triad-intellect.com"

# Premium Order Notification Configuration (Optional)
# If provided, the app will send live email orders using Resend or SMTP.
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
RECEIVER_EMAIL="supervisor@example.com"

# Anti-Spam & Beta Invitation Protection
BETA_INVITE_CODE=""     # Set a code (e.g., BETA30) to secure the requisition endpoint
TURNSTILE_SITE_KEY=""   # Optional: Cloudflare Turnstile Site Key for frontend challenge
TURNSTILE_SECRET_KEY="" # Optional: Cloudflare Turnstile Secret Key for backend siteverify
